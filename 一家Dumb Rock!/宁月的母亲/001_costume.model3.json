          "Priority": 9,
          "Interruptable": true,
          "Text": "寧月も、こういうのが好きだったわね？"
        },
        {
          "Name": "voice_13",
          "Sound": "assets/voices/curated_adv_voice_eventstory_8_06_042.wav",
