          "PostCommand": "lip_sync enable; start_mtn ournotes_l2d_carrier_sub_shizukus_mother ws_manual_voice_finished_1#9",
          "Priority": 9,
          "Interruptable": true,
          "Text": "……ふふ、好奇心旺盛なところがあって"
        },
        {
          "Name": "voice_14",
